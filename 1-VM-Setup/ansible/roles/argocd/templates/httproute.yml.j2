apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argo-server
  namespace: argocd
spec:
  hostnames:
  - {{ argocd_hostname }}
  parentRefs:
  - group: gateway.networking.k8s.io
    kind: Gateway
    name: central
    namespace: kube-system
  rules:
  - backendRefs:
    - group: ""
      kind: Service
      name: argocd-server
      port: 80
      weight: 1
    matches:
    - path:
        type: PathPrefix
        value: /